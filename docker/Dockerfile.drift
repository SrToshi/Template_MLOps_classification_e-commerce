FROM python:3.10-slim

WORKDIR /app

COPY requirements/drift.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/db.py src/drift_detection.py src/mlflow_utils.py ./src/
COPY docker/drift-entrypoint.sh /usr/local/bin/drift-entrypoint.sh
RUN chmod +x /usr/local/bin/drift-entrypoint.sh

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1

# Runs on a loop rather than under cron: one less moving part inside the
# container, and the interval stays visible in docker-compose.
ENTRYPOINT ["/usr/local/bin/drift-entrypoint.sh"]
